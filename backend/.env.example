# Plant AI — Environment Variables Template
# ══════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to Git.
# ══════════════════════════════════════════════

# ── Application ────────────────────────────────
DEBUG=False

# ── Security (REQUIRED) ────────────────────────
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_PYTHON_SECRETS_TOKEN_HEX_64

# ── Database (REQUIRED) ────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DATABASE_NAME=plant_ai

# ── ML Model (REQUIRED) ────────────────────────
# Path relative to project root (Plant-Disease-Analysis/)
MODEL_PATH=ml/output/final_plant_model.keras
CLASS_PATH=ml/output/classes.json

# ── CORS (Production) ──────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave as * only for local development
BACKEND_CORS_ORIGINS=*

# ── Token Expiry ───────────────────────────────
# JWT token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
