# ── Application Configuration ──────────────────────────────────
APP_NAME="LeafGuard AI"
VERSION="2.0.0"
DEBUG=False
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# ── Security & Authentication ─────────────────────────────────
SECRET_KEY="generate_a_secure_random_64_character_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── MongoDB Database ──────────────────────────────────────────
# Leave blank for local offline file storage fallback
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="leafguard_ai"

# ── ML Model & Paths ──────────────────────────────────────────
MODEL_PATH="backend/models/plant_disease_model.keras"
CLASS_PATH="backend/models/class_names.json"
METRICS_PATH="backend/models/model_metrics.json"
DISEASE_INFO_PATH="backend/data/disease_info.json"

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=True

# ── CORS Configuration ────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
