archive.zip
**/archive.zip
ml/PlantVillage/
ml/archive.zip
ml/data/
ml/output/*.keras
ml/output/*.pth
ml/output/*.h5
dataset/


# ── Logs ───────────────────────────────────────
*.log
logs/
backend/logs/
ml/logs/

# ── Uploads (user temp files) ──────────────────
uploads/
backend/uploads/
backend/app/uploads/

# ── Frontend Build ─────────────────────────────
node_modules/
frontend/dist/
frontend/.cache/
frontend/build/

# ── OS & Editor ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── IDEs ───────────────────────────────────────
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ── Testing ────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# ── Jupyter ────────────────────────────────────
.ipynb_checkpoints
*.ipynb

