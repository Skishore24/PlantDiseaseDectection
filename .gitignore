# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.pyc
*.pyo

# ── Virtual Environments ───────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Environment Variables (NEVER commit secrets) ─
.env
.env.*
!.env.example

# ── ML Models & Large Binaries ─────────────────
